# --- apps/server (copy to apps/server/.env for local dev) ---

# Neon Postgres pooled connection string
DATABASE_URL=

# >= 32 chars, generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin the auth handler is served from
BETTER_AUTH_URL=http://localhost:8787

# "true" only until the single account is created, then flip to "false"
ALLOW_SIGNUP=true

# Dashboard origin for CORS + Better Auth trustedOrigins
DASHBOARD_ORIGIN=http://localhost:5173

# --- Stage 2 (synthesis + answer flow) ---

# Anthropic API key (server-side; used by /compile and /answer)
ANTHROPIC_API_KEY=

# Cron auth. Locally: any random string, pass it as `Authorization: Bearer <value>`.
# On Vercel: set this env var and Vercel auto-sends the Bearer header to the cron path.
CRON_SECRET=
